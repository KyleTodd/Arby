# The Odds API Key (for sports betting odds)
# Get your API key from https://the-odds-api.com/
API=your_odds_api_key_here

# The Racing API Credentials (for horse racing odds)
# Get your credentials from https://www.theracingapi.com/
# You'll receive a username and password via email after subscription
RACING_API_USER=your_racing_api_username
RACING_API_PASSWORD=your_racing_api_password

# Server Configuration
PORT=5000
BASE_URL=http://localhost
